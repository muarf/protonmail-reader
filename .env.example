# ProtonMail credentials (optional if already logged in via firefox-profile)
PROTON_EMAIL=your@proton.me
PROTON_PASSWORD=your_password

# Paths
PROFILE_DIR=./firefox-profile
STATE_FILE=./state.json

# Behavior
MAX_PER_RUN=20
INBOX_ONLY_SINGLE=true
HEADLESS=false
DISPLAY=:1
XAUTHORITY=/home/ubuntu/.Xauthority

# SMTP example
# SMTP_HOST=mail.example.org
# SMTP_PORT=587
# SMTP_USER=user@example.org
# SMTP_PASS=password
# FORWARD_TO=dest@example.org

# Webhook example
# WEBHOOK_URL=https://example.com/webhook
